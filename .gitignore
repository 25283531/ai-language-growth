# Secrets and credentials — never commit these
.env
.env.*
!.env.example
*credentials*
*secret*
*.pem
*.key
id_rsa*
id_ed25519*
github-token.txt
*.token

# Node / NestJS / Next.js
node_modules/
dist/
build/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Android / Kotlin
*.apk
*.aab
# 本地打包 zip（含 debug APK），不是源码；报告仍可单独跟踪
deliverables/android/*.zip
local.properties
.gradle/
app/build/
*/build/
*.iml
.idea/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
*.swp

# Runtime artifacts
*.tsbuildinfo
/tmp/
.cache/
# 真实 TTS 合成产物（内容指纹命名，落盘仅供本地播放，不入库）
.cache/audio/*.mp3
.cache/audio/*.wav
