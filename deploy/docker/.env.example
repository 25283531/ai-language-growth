# ---- 数据层 ----
# 本地开发指向远程服务器 Docker 内网地址，或直接用 compose 服务名
DATABASE_URL=postgresql://alg:CHANGE_ME@127.0.0.1:5433/ai_language_growth?schema=public
REDIS_URL=redis://127.0.0.1:6380
# 队列使用独立 Redis；以下服务名仅供 Compose 内网使用，不发布宿主端口。
QUEUE_REDIS_URL=redis://redis-queue:6379
# 可覆盖的开发初始值，非容量评估；生产须实测容量并预留 AOF 重写等开销。
QUEUE_REDIS_MAXMEMORY=256mb

# ---- 运行环境 ----
NODE_ENV=development
PORT=3100

# ---- 管理后台 ----
ADMIN_WEB_PORT=3001
WEB_PORT=3002
# 浏览器可访问的后端完整 API 基地址，部署时替换成服务器域名/HTTPS 地址
NEXT_PUBLIC_API_BASE=http://localhost:3100/api/v1
# 管理后台登录账号（只保存在部署服务器 .env，不提交 GitHub）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# 可选：用于签名管理会话的独立随机字符串
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SESSION_SECRET
# 32字节（64位十六进制）AES-256-GCM 密钥。生成示例：openssl rand -hex 32
MODEL_CONFIG_ENCRYPTION_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS

# ---- 邮箱注册 / 密码找回 ----
# SMTP 在后台「系统设置」中配置并加密保存在数据库。
PASSWORD_RESET_URL=http://localhost:3002/reset-password
MAIL_DISABLED=false

# ---- 会员每日云端语音额度（秒/学习者/UTC 自然日）----
# 非注册访客固定为 0；高级会员不设上限。价格由运营策略确定，部署值可覆盖免费和会员默认额度。
FREE_ASR_DAILY_QUOTA_SECONDS=300
FREE_TTS_DAILY_QUOTA_SECONDS=300
FREE_PRONUNCIATION_DAILY_QUOTA_SECONDS=300
MEMBER_ASR_DAILY_QUOTA_SECONDS=1800
MEMBER_TTS_DAILY_QUOTA_SECONDS=1800
MEMBER_PRONUNCIATION_DAILY_QUOTA_SECONDS=1800

# 生成独立课程服务与主后端之间的内部访问令牌，请自行生成随机值。
CURRICULUM_GENERATOR_TOKEN=

# ---- AI Gateway 模式 ----
# mock = 使用内置 Mock Provider Adapter（不产生外部调用与费用）
# live = 走真实供应商（需填入下面对应环境变量）
AI_GATEWAY_MODE=mock
# 逗号分隔，只列真正想调用真实服务的种类；去掉 tts 即可零 TTS 调用。
# 未配置对应 *_BASE_URL 的服务会自动回落 Mock，不会静默降级。
AI_GATEWAY_LIVE_SERVICES=llm,asr,tts

# ---- 通用规则 ----
# 所有 URL / 模型名 / 音色名 / 凭据只在配置里出现，packages/ 与 services/
# 业务代码不得出现任何厂商名、模型名或音色名（约束二）。
# 换供应商只改本文件，不改业务代码。
#
# *_EXTRA_BODY_KV 用无引号的 `key:value;key:value` 形式：
# 环境变量经 shell source 注入时，JSON 里的双引号会被 shell 吃掉。
# 也兼容 JSON 对象（适合容器 env_file）。

# ---- LLM ----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 推理型模型会先消耗思考预算，max_tokens 太低会得到空回复
LLM_MIN_MAX_TOKENS=
# 例：推理型模型降低思考强度
LLM_EXTRA_BODY_KV=
# 额外请求字段策略：required（需注入期望 KV）/ none（不要求额外字段）。
# 回滚到非思考型模型时把本项改为 none，并把 LLM_EXTRA_BODY_KV 置为空值，
# 同时确认 LLM_EXTRA_BODY_JSON 别名也为空或不存在（不要只删 KV 键，否则 ?? 会
# 回退到别名、残留推理字段）；LLM_REQUIRED_EXTRA_KV 在 none 下不读取，可置空；
# LLM_MIN_MAX_TOKENS 保留任意正整数即可。只需改本文件，不改业务代码（配置层一键回滚）。
LLM_EXTRA_POLICY=required
# 期望注入的额外字段（KV 或 JSON）；policy=required 时逐键与实际注入值比对。
LLM_REQUIRED_EXTRA_KV=reasoning_effort:low
# 逗号分隔，追加到代码内的通用业务字段保护清单，防止配置覆盖业务字段。
LLM_FORBIDDEN_EXTRA_KEYS=thinking

# ---- TTS ----
# 协议形态二选一（两者都是公开协议，代码里不写厂商名）：
#   openai_audio      = POST {baseUrl}/audio/speech，直接返回二进制音频
#   signed_json_audio = 签名请求头 + JSON 响应里的 Base64 音频
TTS_PROTOCOL=openai_audio
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
TTS_EXTRA_BODY_KV=

# signed_json_audio 专用（全部由配置注入）
TTS_SECRET_ID=
TTS_SECRET_KEY=
TTS_SERVICE=
TTS_ACTION=
TTS_VERSION=
TTS_REGION=
# mp3 或 wav；裸 PCM 无容器头、浏览器不可播放，协议层不开放
TTS_CODEC=mp3
TTS_SAMPLE_RATE=
TTS_PRIMARY_LANGUAGE=
TTS_VOLUME=
TTS_MODEL_TYPE=
# 响应体中承载 Base64 音频的字段名，默认 Audio
TTS_AUDIO_FIELD=

# ---- ASR ----
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

# ---- 发音评估（与 ASR 严格分离，D-013）----
# M1 暂无提供音素级评分的服务，留空即走 Mock，绝不拿 ASR 转写冒充发音评分
PRONUNCIATION_API_KEY=
PRONUNCIATION_BASE_URL=
PRONUNCIATION_MODEL=

# ---- 合成音频 ----
# 访问前缀固定为 /api/v1/media/audio，不作为环境变量，
# 避免 Git Bash / MSYS2 把以斜杠开头的路径值改写成 Windows 安装目录
AI_AUDIO_DIR=.cache/audio
# TTS 缓存清理：默认开启，每 6 小时一次，启动 10 分钟后首跑，孤儿文件宽限 7 天。
# 公共课程音频（PUBLIC_CURRICULUM / PRONUNCIATION）永不按 TTL 删除。
TTS_CACHE_CLEANUP_ENABLED=true
TTS_CACHE_CLEANUP_INTERVAL_MS=21600000
TTS_CACHE_CLEANUP_INITIAL_DELAY_MS=600000
TTS_CACHE_ORPHAN_GRACE_MS=604800000

# ---- 计费口径 ----
# 账户资源包属于已付费的预付额度，不是免费调用；不同音色档位/模型分别抵扣。
# M1 未接入价格表，/usage/summary 的 costCny=0 只表示「未计价」(pricingStatus=unpriced)。
