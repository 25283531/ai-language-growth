{
  "name": "ai-language-growth",
  "version": "0.1.0",
  "private": true,
  "description": "Growth-type AI English platform for 6-9 year-old zero-basis children",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web",
    "apps/admin-web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @alg/backend",
    "dev:web": "npm run dev --workspace @alg/web",
    "prisma:generate": "npm run prisma:generate --workspace @alg/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @alg/backend",
    "prisma:seed": "npm run prisma:seed --workspace @alg/backend"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
